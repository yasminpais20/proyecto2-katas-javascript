function findLongestWord2(lista2) {
    let palabraMasLarga2 = "";

    for (const palabra2 of lista2) {
      if (palabra2.length > palabraMasLarga2.length) {
        palabraMasLarga2 = palabra2;
    } else if (palabra2.length === palabraMasLarga2.length) {
      console.log(palabra2 + " es igual a " + palabraMasLarga2); /* aqui imprimimos el caso de empate de número de elementos del string, también nos imprimirá los casos que noi son el mayor, ya que sólo hemos puesto como condición que sean iguales en longitud*/
    }
  }

      console.log("Palabra más larga: " + palabraMasLarga2);
}

       findLongestWord2(avengers);