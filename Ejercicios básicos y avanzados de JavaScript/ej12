/* Ejercicio 12

Valores únicos: Crea una función que reciba por parámetro un array y compruebe si existen elementos duplicados, en caso que existan los elimina para retornar un array sin los elementos duplicados.
Pista: puedes generar un nuevo array y devolverlo.
Puedes usar este array para probar tu función: */

const duplicates = [
  'sushi',
  'pizza',
  'burger',
  'potatoe',
  'pasta',
  'ice-cream',
  'pizza',
  'chicken',
  'onion rings',
  'pasta',
  'soda'
];
function removeDuplicates(list) {
  
 const listaUnicos =[];/* Iniciaremos con un array vacio el que le iremos metiendo los elementos que no se repitan, seria el acumulador*/

 for(const element of list){ // Usamos un for of para recorrer todo el array

   if (!listaUnicos.includes(element)){ /* Así si la listaUnicos no incluye el elemento que estamos pasando con el push lo meteremos al final de este array si no lo cumple simplemente no lo incluye en este nuevo array*/
    listaUnicos.push(element);
   }
 }
     console.log(listaUnicos); /* El profe le mete un consol log aquí yo en los anteriores lo estaba haciendo con un return y sacando el console.log fuera, valen los dos, con el return lo podríamos reutilizar, pero para mostrarlo en pantalla vale este  */ 


}

removeDuplicates(duplicates); /* Lo que estamos haciendo es recorrer un array generar otro con la condición de que no sea un elemento repetido, si está repetido solo se incluye una vez*/