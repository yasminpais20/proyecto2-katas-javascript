/*Ejercicio 31
Dada una lista de artistas con sus influencias, utiliza bucles anidados para listar todos los artistas y sus influencias directas e imprime cada par por consola.
*/
const artists = [
  { name: 'Kurt Cobain', influences: ['The Beatles', 'Pixies', 'Lead Belly'] },
  { name: 'David Bowie', influences: ['Little Richard', 'Chuck Berry', 'The Velvet Underground'] },
  { name: 'Eddie Vedder', influences: ['The Who', 'Neil Young', 'Jim Morrison'] },
  { name: 'Freddie Mercury', influences: ['Liza Minnelli', 'Jimi Hendrix', 'Aretha Franklin'] },
  { name: 'John Lennon', influences: ['Elvis Presley', 'Chuck Berry', 'Buddy Holly'] }
];

/* Analogía del reloj para bucles anidados:
El bucle externo representaría las horas, avanza despacio y por cada paso que da se queda quieto esperando que a que el bucle interno termine.
El bucle interno representaría los minutos, avanza rápido y tiene que dar su vuelta completa(60 pasos) antes de que el bucle externo pueda dar su siguiente paso*/

/*  por cada artista(bucle externo), tenemos que dar una vuelta completa por todas sus influencias(bucle interno) antes de pasar al siguiente artista*/

//1 BUCLE EXTERNO(horas del reloj)

for(const artist of artists) { /* Con esto recorremos el array principal de artistas uno a uno*/

  //2 BUCLE INTERNO(los minutos)

for(const influence of artist.influences){ /* Con el artista actual en la mano, accedemos a su propiedad influences( que es otro array)*/

  /* Ahora imprimimos el resultado en un console.log donde podremos acceder a artist.name (del bucle de fuera) como a influence(del bucle de dentro)*/

  console.log(`${artist.name} fue influenciado por ${influence}`);


}

}

