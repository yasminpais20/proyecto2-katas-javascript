/* También podemos plantear este ejercicio con un for each que es muy similar al bucle for of, pero le da una nueva sintaxix usando callbbacks y arrow functions, pero ojo sólo nos servirá para recorrer arrays puesto que es un método de array*/

const numbers=[1,2,3,4,5,6,7];

numbers.forEach((number)=>
  {console.log(number);

})




/* Sería enntonces: (aqui lo usamos porque  solo queremos hacer bucles anidados sin devolver un nuevo array y ejecutando solo un console.log) por cada elemento que haya en este array, ejecuta esta función*/

// Bucle externo
artists.forEach(artist => { /* aqui artists es nuestro array principal, la lista con los 5 objetos de los músicos, el forEach es para recorrer la lista completamente; y artist =>{ es la función flecha (la prueba), artist es el parametro que nos inventamos para nombrar al elemento individual que cogemos en cada vuelta*/ 
  
  // Bucle interno
  artist.influences.forEach(influence => { // accedemos  a un array(influences) que esta escondido dentro de un objeto, que a su vez está dentro de otro array(artists)
    
    console.log(`${artist.name} - ${influence}`);/* el bucle interno siempre tiene acceso a las variables del bucle externo, por eso hemos podido meter artist.name e influence en el mismo console.log y nos daría el mismo resultado, asi que todo ok*/
    
  });
});