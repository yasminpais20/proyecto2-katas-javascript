/*Ejercicio 14

Contador de repeticiones: Crea una función que nos devuelva el número de veces que se repite cada una de las palabras que lo conforma.
Por ejemplo, que devuelva: code:4, repeat: 1, eat: 1,...
Podéis conformar el formato que queráis para la devolución del resultado siempre y cuando sea claro.
Puedes usar este array para probar tu función:*/

const words = [
  'code',
  'repeat',
  'eat',
  'sleep',
  'code',
  'enjoy',
  'sleep',
  'code',
  'enjoy',
  'sleep',
  'code'
];
function repeatCounter(list) {
   const contador ={};  /*Creamos como contador un objeto vacíko, hasta ahora han sido un número (lets suma=0) o un array vacío( const unicos[]) pero ahora hay que guardar dos datos a la vez, el nombre de  la palabra y cuantas veces a salido) */
     for(const palabra of list){  // Recorremos cada palabra de la lista con un for of, aqui los indices nos dan igual así que con este es más fácil.
      if(contador[palabra]){ // Con esto comprobamos si la palabra ya esta anotada en nuestro contador         
        
        contador[palabra] += 1; /* Si ya estaba apuntada le sumamos 1 al numero de veces que esta, ojo aqui tiene que hacerse con la forma contador[palabra]  no contador.palabra  par aacceder a la propiedad del objeto ya que es dinamico, osea de una variable ya que este contador va a ir variando con cada vuelta del bucle*/
      }else{
        contador[palabra] = 1 // Si no esta apuntada, la apuntamos en el objeto y le ponemos un uno

      }
    }
        return contador; // Retornamos el objeto con todas las anotaciones una vez terminado el bucle


}

const resultado = repeatCounter(words);
console.log(resultado);// Nos da el resultado  { code: 4, repeat: 1, eat: 1, sleep: 3, enjoy: 2 }



/* También podemos hacerlo con el método .reduce() ya que ese sirve para recucir un array a un solo valor y con los ajustes adecuados este puede ser un objeto con puntuaciones */


function repeatCounter2(list2) {
  
  // retornamos el reduce directamente
  return list2.reduce((acumulador2, palabra2) => {  
    
    if (acumulador2[palabra2]) {
      acumulador2[palabra2] += 1; // si existe, suma 1
    } else {
      acumulador2[palabra2] = 1;  // si no existe, inicializa en 1
    }
    
    return acumulador2; //  en reduce siempre tenemos quew devolver el acumulador preparado para la siguiente vuelta
    
  }, {}); //  nuestro valor inicial ya no es un 0, es un objeto vacío {}, cuidado con esto
  
}

console.log(repeatCounter2(words));// El resultado dará : { code: 4, repeat: 1, eat: 1, sleep: 3, enjoy: 2 }

