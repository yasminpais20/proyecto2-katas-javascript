const humanCharacters2 = [];


for (const character2 of characters) { // recorremos el array original de personajes 
  
  
  if (character2.species === 'Human') { /* verificamos que el valor de la propiedad species es igual a Human */
    
    
    humanCharacters2.push(character2); // si se cumple metemos el objeto del personaje enetero en el nuevo array
  }
}


