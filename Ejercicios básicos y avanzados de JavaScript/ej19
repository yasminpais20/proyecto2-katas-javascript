/*Ejercicio 19

Mixed For...of e includes: Usa un bucle for...of para recorrer todos los juguetes y elimina los que incluyan la palabra gato (también podéis crear uno nuevo con solo los que NO incluyan esa palabra).
Recuerda usar la función .includes() para comprobar la palabra.
Puedes usar este array: */

const toys = [
    {id: 5, name: 'Transformers'},
    {id: 11, name: 'LEGO'},
    {id: 23, name: 'Hot Wheels'},
    {id: 40, name: 'Rascador de gato'},
    {id: 40, name: 'FurReal Friends gato interactivo'},
    {id: 60, name: 'Nerf Blaster'},
    {id: 71, name: 'Sylvanian Families - Familia gato'}
];

/* El problema es qu9e si intentamos usar el splice() para ir borrando los elementos que contengan gato del array original, los indices van resbalando si borramos elementos y en el for of no tenemos control sobre el indice(i) para restarle uno y ajustar eso, asi que el bucle avanza y se va a saltar cosas si borra algo*/

//Tendremos que crear un array nuevo

const juguetesSingato =[];/* Creamos un array vacío donde iremos metiendo los elementos que no contengan gato*/

for (const toy of toys) { /* recorremos el array original con el for of */
   if(!toy.name.includes('gato')){ /* Condicional que si se cumple con el push nos mete el elemento al final de nuestra nueva lista, la condicion es que el nombre no(!) inclua la palabra gato*/
       juguetesSingato.push(toy);    


   }
}

console.log(juguetesSingato);
/* Nos da: Todo ok
[
  { id: 5, name: 'Transformers' },
  { id: 11, name: 'LEGO' },
  { id: 23, name: 'Hot Wheels' },
  { id: 60, name: 'Nerf Blaster' }
]
*/

/*También podemos hacerlo con filter()*/

const juguetesFiltradosSinMichi = toys.filter(toy => !toy.name.includes('gato')); /* Con esto nos quedamos directamente con los que no contengan gato */

console.log(juguetesFiltradosSinMichi);

