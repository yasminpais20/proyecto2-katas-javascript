for(let i=1;i<=10; i++)

    if (i===10){ // aquí nos valdría igual el i==10
       
        console.log("Dormido zzz");}
       
    else{ 
    
         console.log("Intentando dormir 🐑"); 
         
    }



    // 1.3 Y dandole otra vuelta queda mejor así

for(let i = 1; i <= 10; i++){ 

    if (i === 10) { 
        // En la vuelta 10 lanzamos un solo console.log
        console.log(`Dormido zzz en la oveja ${i}`);
    } 
    
    else { 
        // En las vueltas 1 a 9 lanzamos un solo console.log
        console.log(`Intentando dormir 🐑 oveja número ${i}`);
    }
}