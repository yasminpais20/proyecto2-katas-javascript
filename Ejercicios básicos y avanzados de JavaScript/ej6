//1.2 Mostramos el valor por consola solo cuando el resto dividido entre 2 sea 0 (osea que sean pares)

for(let i=0; i<10; i++) { /*Aqui empezamos con el primer bucle, inicializamos el bucle en 0 con i=0( el indice que nos va contando las vueltas), ponemos que vaya aumentando 1 en cada vuelta(i++) y le decimos que pare de contar en el n 9 (i<10)*/

    if(i % 2 ===0){ /* Para meter la condición de que sea par le metemos el condicional if, que si es par nos imprimirá el indice, (0 cuanta como par) si no pasará al siguiente valor sin imprimir  */
        
        console.log(i);// Imprimirá 0,2,4,6,8

    }
}

//1.3 Bucle para dormir contando ovejillas 🐑

for(let i=1;i<=10; i++){ /* Aqui he inicializado el bucle en 1 ya que es más natural en humano contar de 1 a 10 y para que de 10 vueltas le añadimos el <=10 ya que con <10 nos daría solo 9 vueltas */

    if (i===10){ // Empezamos a contar en 1, la decima vuelta pasa en i=10, y ya nos quedariamos dormidos
       
        console.log("Dormido zzz");// Cuando llegamos a la vuelta final i=10 la condición se cumple y se abre la puerta del if y nos quedamos dormidos
        console.log(i);
    }
    else{ 
    
         console.log("Intentando dormir 🐑"); // Durante las primeras 10 vueltas (i del 1 al 9), la condición i===10 es falsa, asi que el código entra por el else
         console.log(i);
    }
    // Esta estructura If else  dentro del bucle nos asegura que en cada iteración solo hacemos un console.log , yo añadi uno más por vuelta solo a efectos de que me vaya indicando que el numero de vueltas es el correcto

}

