const cancionesPorGenero2 = {}; /* Aquí creamos otro objeto pero  esta vez lo dejamos vacio, en este caso no le añadimos ninguna propiedad de antemano*/

for (const track of tracks) { /* empezamos a recorrer el array tracks uno a uno, en cada vuelta track es el objeto completo de una canción, en la primera vuelta será  track: {title: 'Enter Sandman', genre:'Metal' en esta el track.genre valdrá Metal  */
  if (!cancionesPorGenero2[track.genre]) { /* track.genre en esta primera vuelta valdría Metal como, seria cancionesPorGenero["Metal"], aquí estamos pidiendo una propiedad que no existe en el objeto, ya que empezamos con él vacío, así nos devolverá undefined, como tenemos el operador! al principio y al comportarse undefinded aqui como un false, se invierte su valor y devuelve un true, por el que entramos en esta rama del condicional  y como no hay nada en el objeto en la primera vuelta creamos la propiedad, (objeto[clave]= valor en un objeto crea la propiedad si no existe o sobreescribe la que ya existia*/ 

  /* en sucesivas vueltas si ya tenemos creado ese array nos dará un true y con ! la negación que tenemos al principio de la linea irá directamente fuera del if, sin crear ni sobreescribir nada*/
    
    cancionesPorGenero2[track.genre] = []; /* Ojo aqui hemos creado la propiedad, pero el array sigue vacio*/
  }
  cancionesPorGenero2[track.genre].push(track); /* ahora al salir del if, tendremos cancionesPorGenero[track.genre] que es el array que acabamos de crear en esta primera 
    vuelta, con metal, sobre este array tenemos el push(track) que nos añade el objeto entero de la cancion al final del array.*/
  
