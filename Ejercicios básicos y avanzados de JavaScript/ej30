/*Ejercicio 30
Dada una lista de canciones, clasifícalas en un objeto donde las claves sean los géneros y los valores sean arrays de canciones de ese género.
Utiliza bucles para estructurar este objeto e imprime el resultado por consola. */

const tracks = [
  { title: 'Enter Sandman', genre: 'Metal' },
  { title: 'Back in Black', genre: 'Rock' },
  { title: 'Bohemian Rhapsody', genre: 'Rock' },
  { title: 'Blinding Lights', genre: 'Pop' },
  { title: 'Old Town Road', genre: 'Country' },
  { title: 'Smells Like Teen Spirit', genre: 'Grunge' },
  { title: 'Bad Guy', genre: 'Pop' },
  { title: 'Thunderstruck', genre: 'Rock' },
  { title: 'Hotel California', genre: 'Rock' },
  { title: 'Stairway to Heaven', genre: 'Rock' }
];

/* Primero vamos a crear un objeto, que a su vez contendrá los arrays que representaran cada género musical y mediante condicionales y el acceder al objeto track.genre=== y y con un push los iremos clasificando*/ 
const cancionesPorGenero = {
    "Metal"  :[],
    "Rock"   :[],
    "Pop"    :[],
    "Country":[],
    "Grunge" :[]
};

 for (const track of tracks){

    if(track.genre ==='Metal'){ /* Si es genre(género) es estrictamente igual a metal lo metemos en el objeto que creamos para clasificar (cancionesPorGenero) dentro del array Metal */
       cancionesPorGenero["Metal"].push(track); /* metemos la canción por la que estamos pasando en el bucle(track) mediante un push concretando que lo estamos metiendo en cancionesPor Genero en el array Metal*/
    
    }else if(track.genre ==='Rock'){
        cancionesPorGenero["Rock"].push(track); /* Ojo en esta parte .push es un método(una función) de los arrays, para que una función se ejecute, siempre debemos llamarla utilizando paréntesis () y pasarle dentro del elemento que queremos guardar como argumento ( que es el dato real o valor exacto que le entregamos a una funcion); si le metiesemos un .push.track piensa que estamos intentando buscar una propiedad llamada track dentro de la función push, no ejecutará la acción y el array se quedará vacio [] */  /* Sin () si estás mirando la función; () si estás usando la función.*/

    }else if(track.genre ==='Pop'){
        cancionesPorGenero["Pop"].push(track);
    
    }else if(track.genre ==='Country'){
        cancionesPorGenero["Country"].push(track);
    
    }else if(track.genre ==='Grunge'){
        cancionesPorGenero["Grunge"].push(track);
    }

}

console.log(cancionesPorGenero);
